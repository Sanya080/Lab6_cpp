#include <iostream>
#include <iomanip>
#include <cmath>
#include <cstdlib>
#include <ctime>
using namespace std;

// Максимальна довжина статичного масиву. Пам'ять виділяється під MAX елементів,
// а реальну довжину n вводить користувач (n <= MAX).
const int MAX = 100;

int main()
{
    double a[MAX];   // статичний масив дійсних чисел
    int n;           // реальна кількість елементів масиву
    int mode;        // спосіб заповнення масиву

    // Введення реальної довжини масиву з перевіркою коректності
    cout << "Введіть кількість елементів масиву n (від 1 до " << MAX << "): ";
    cin >> n;
    while (n < 1 || n > MAX)
    {
        cout << "Помилка: n має бути від 1 до " << MAX << ". Введіть n ще раз: ";
        cin >> n;
    }

    // Вибір способу заповнення масиву
    cout << "Спосіб заповнення масиву:" << endl;
    cout << "  1 - випадкові числа (rand)" << endl;
    cout << "  2 - ввести вручну" << endl;
    cout << "Ваш вибір: ";
    cin >> mode;
    while (mode != 1 && mode != 2)
    {
        cout << "Помилка: введіть 1 або 2: ";
        cin >> mode;
    }

    if (mode == 1)
    {
        // Ініціалізація датчика випадкових чисел поточним часом
        srand((unsigned)time(0));

        // Заповнення масиву через вказівник p, що проходить від a до a + n
        for (double *p = a; p < a + n; p++)
        {
            *p = rand() % 41 - 5;      // ціле число від -5 до 35
            if (rand() % 4 == 0)       // приблизно кожне четверте число робимо дробовим
                *p += 0.5;
        }
    }
    else
    {
        // Ручне введення елементів; звертання до елемента через *(a + i)
        for (int i = 0; i < n; i++)
        {
            cout << "a[" << i + 1 << "] = ";
            cin >> *(a + i);
        }
    }

    // Виведення масиву на екран по 10 елементів у рядку
    cout << endl << "Початковий масив (n = " << n << "):" << endl;
    cout << fixed << setprecision(1);
    for (int i = 0; i < n; i++)
    {
        cout << setw(8) << *(a + i);
        if ((i + 1) % 10 == 0)
            cout << endl;
    }
    cout << endl << endl;

    double product = 1;   // добуток знайдених елементів (початкове значення 1)
    int count = 0;        // кількість знайдених елементів

    cout << "Елементи, що є точними квадратами:" << endl;

    // Прохід по масиву вказівником p
    for (double *p = a; p < a + n; p++)
    {
        // Точний квадрат - це квадрат натурального числа (1, 4, 9, 16, ...)
        if (*p >= 1)
        {
            // r - найближче ціле до кореня з елемента
            double r = floor(sqrt(*p) + 0.5);

            // Елемент є точним квадратом, якщо r*r дорівнює йому
            if (fabs(r * r - *p) < 1e-9)
            {
                count++;
                product *= *p;
                cout << "  a[" << (p - a + 1) << "] = " << *p
                     << "  (" << (int)r << "^2)" << endl;
            }
        }
    }

    cout << endl;
    if (count == 0)
        cout << "Точних квадратів у масиві немає, добуток не обчислюється." << endl;
    else
    {
        cout << "Кількість точних квадратів: " << count << endl;
        cout << defaultfloat << setprecision(12);
        cout << "Добуток точних квадратів: " << product << endl;
    }

    return 0;
}
